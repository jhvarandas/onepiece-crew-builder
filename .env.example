# Copy to .env (gitignored) and fill in. On Vercel, set the same names in the project settings.

# Contentful: the site and the publish webhook
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_LOCALE=en-US
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
# The webhook's request-verification signing secret (64 characters)
CONTENTFUL_WEBHOOK_SECRET=

# Contentful: migrations and `pnpm content:seed` only, never the deployed app
CONTENTFUL_MANAGEMENT_TOKEN=

# Supabase: the pointer, lease, events and build log (supabase/migrations/)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vercel Blob: raw snapshots (set automatically when a Blob store is connected to the project)
BLOB_READ_WRITE_TOKEN=

# The public site, for the post-purge canary; leave empty until /__canary exists
SITE_URL=
