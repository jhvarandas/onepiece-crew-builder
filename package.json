{
  "name": "onepiece-x",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "content:vocab": "UPDATE_VOCAB=1 vitest run test/content/model.test.ts",
    "content:seed-data": "UPDATE_SEED=1 vitest run test/content/seed.test.ts",
    "content:seed": "node --env-file-if-exists=.env contentful/seed.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "nuxt": "^4.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@contentful/node-apps-toolkit": "4.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "~5.8.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
